# backoffice-web — Angular 22 admin SPA → nginx static
# build: docker build -f deploy/docker/Dockerfile.backoffice-web -t albaraka-ai/backoffice-web:dev .
FROM node:22-alpine AS build
WORKDIR /src
COPY apps/package.json apps/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/ ./
RUN npm run build:ui && npx ng build backoffice-web --configuration production --base-href /admin/ --deploy-url /admin/

FROM nginx:1.28-alpine
COPY deploy/docker/nginx.backoffice.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/backoffice-web/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD ["sh", "-c", "wget -q -O /dev/null http://127.0.0.1/admin/ || exit 1"]
