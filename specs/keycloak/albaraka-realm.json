{
  "realm": "albaraka",
  "enabled": true,
  "displayName": "Al Baraka Bank — Assistant Al-Mouchir",
  "displayNameHtml": "<strong>Al Baraka Bank</strong> — Assistant Al-Mouchir",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": true,
  "loginTheme": "albaraka",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "albaraka",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "ar",
    "en"
  ],
  "defaultLocale": "fr",
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "clientOfflineSessionIdleTimeout": 0,
  "clientOfflineSessionMaxLifespan": 0,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 1,
  "defaultSignatureAlgorithm": "PS256",
  "bruteForceProtected": true,
  "permanentLockout": true,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyRpEntityName": "Al Baraka Bank",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "not specified",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyCreateTimeout": 0,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "adminPermissionsEnabled": false,
  "organizationEnabled": false,
  "clientPoliciesPolicies": {
    "policies": [
      {
        "name": "pkce-s256-for-all-public-clients",
        "description": "Every public client must present a PKCE code challenge hashed with S256. Plain is refused.",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-scopes",
            "configuration": {
              "scope": "pkce-enforced"
            }
          }
        ],
        "profiles": [
          "pkce-s256"
        ]
      },
      {
        "name": "token-exchange-disabled",
        "description": "Standard token exchange stays off: it is a recurring CVE surface and no use case needs it (docs/07 §2.3).",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-scopes",
            "configuration": {
              "scope": "token-exchange-denied"
            }
          }
        ],
        "profiles": [
          "token-exchange-off"
        ]
      }
    ]
  },
  "clientProfiles": {
    "profiles": [
      {
        "name": "pkce-s256",
        "description": "Force S256 code challenge method.",
        "executors": [
          {
            "executor": "pkce",
            "configuration": {
              "attribute.name": "pkce.code.challenge.method",
              "pkce.code.challenge.method": "S256"
            }
          }
        ]
      },
      {
        "name": "token-exchange-off",
        "description": "No executor: the profile exists so the policy above has something to attach to. Token exchange is disabled realm-wide by never granting the `token-exchange` scope.",
        "executors": []
      }
    ]
  },
