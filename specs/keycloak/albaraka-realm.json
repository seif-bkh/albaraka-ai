  "clients": [
    {
      "clientId": "albaraka-assistant-web",
      "name": "Assistant Al-Mouchir — frontoffice web",
      "description": "Customer chat application. Authorization Code + PKCE (S256), short-lived tokens, rotating refresh.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "consentRequired": false,
      "rootUrl": "${FRONTOFFICE_URL}",
      "baseUrl": "/chat",
      "redirectUris": [
        "/chat/*",
        "/silent-refresh.html"
      ],
      "webOrigins": [
        "+"
      ],
      "notBefore": 0,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "access.token.lifespan": "300",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "28800",
        "use.refresh.tokens": "true",
        "tls.client.certificate.bound.access.tokens": "false",
        "require.pushed.authorization.requests": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-assistant-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "albaraka-assistant-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "locale-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "locale",
            "claim.name": "locale",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String",
            "aggregate.attrs": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "aud-assistant-api"
      ],
      "optionalClientScopes": [],
      "authorizationServicesEnabled": false
    },
