  "authenticationFlows": [
    {
      "id": "9c3f1f2a-6d1e-4b7a-9c05-a1ba4a1a0001",
      "alias": "backoffice browser — MFA required",
      "description": "Backoffice login: credentials then a mandatory second factor (TOTP or WebAuthn). A user without a second factor is forced to enrol; there is no skip.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 30,
          "flowAlias": "backoffice mandatory second factor",
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "id": "9c3f1f2a-6d1e-4b7a-9c05-a1ba4a1a0002",
      "alias": "backoffice mandatory second factor",
      "description": "TOTP or a WebAuthn passkey. Both ALTERNATIVE so either satisfies the REQUIRED subflow; no DISABLED and no CONDITIONAL escape hatch.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
