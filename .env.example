# ══════════════════════════════════════════════════════════════════════════════════════════════
#  .env.example — local development secrets and overrides (deploy/docker-compose.yml)
# ══════════════════════════════════════════════════════════════════════════════════════════════
#  Copy to `.env` (git-ignored) and fill in. Never commit a real value: everything with a real
#  secret here would be a finding (pre-commit gitleaks + config-lint X-group). Values marked
#  "optional" have the documented dev defaults in docker-compose.yml.
#
#  Stack: Postgres+pgvector · Redis · Keycloak · MinIO · rag-assistant (Python/LangChain) ·
#         server (Spring Boot) · frontoffice-web + backoffice-web (Angular) · nginx edge.
#  Start: `docker compose --profile app up --build` (or `make up`). Mock mode = no keys.

# ── provider keys — OPTIONAL, consumed ONLY by rag-assistant (ADR-009) ───────────────────────
#  Leave both empty and keep RAG_PROVIDER_MODE=mock to run the deterministic demo pipeline
#  with no paid API. Set them + RAG_PROVIDER_MODE=live for real models (Groq chat/rerank,
#  Google embeddings).
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── internal RAG service (ADR-009 / docs/08 §8) ──────────────────────────────────────────────
#  Must match the value the `server` container uses to authenticate its calls.
RAG_SERVICE_TOKEN=dev-rag-token-change-me
RAG_PROVIDER_MODE=mock          # mock | live
RAG_VECTOR_BACKEND=mock          # mock | pgvector
RAG_CHAT_MODEL=llama-3.3-70b-versatile
RAG_RERANKER_MODEL=llama-3.1-8b-instant
RAG_EMBED_MODEL=gemini-embedding-001

# ── optional overrides ──────────────────────────────────────────────────────────────────────────
GROQ_BASE_URL=https://api.groq.com
ALBARAKA_DAILY_BUDGET_USD=5.00

# ── keycloak server-side token bridge (confidential client; spring uses it for the backoffice password grant)
KEYCLOAK_BRIDGE_CLIENT_SECRET=dev-bridge-secret-change-me
BRIDGE_CLIENT_SECRET=${KEYCLOAK_BRIDGE_CLIENT_SECRET}

# ── bootstrap passwords (compose requires these; never use the documented dev default in shared envs)
#    Docker Compose fails at interpolation when any of them is empty, so the dev defaults below
#    are what `make up` (tools/env-sync.sh) seeds into a fresh or stale .env. Change them in .env
#    before exposing the stack anywhere shared.
#    HARD REQUIREMENT: MINIO_ROOT_PASSWORD must be ≥8 characters (MinIO refuses to start with a
#    shorter secret — the container is reported "unhealthy"). env-sync now rejects short values.
POSTGRES_PASSWORD=dev-postgres-change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-admin-change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=dev-minio-change-me

# Keycloak realm placeholders (dev defaults in docker-compose.yml — override for shared dev envs)
FRONTOFFICE_URL=http://localhost:9000
BACKOFFICE_URL=http://localhost:9000/admin
BANK_PUBLIC_URL=http://localhost:9000
WIDGET_REDIRECT_URI=http://localhost:9000/assistant/callback
