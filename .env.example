# ══════════════════════════════════════════════════════════════════════════════════════════════
#  .env.example — local development secrets and overrides (deploy/docker-compose.yml)
# ══════════════════════════════════════════════════════════════════════════════════════════════
#  Copy to `.env` (git-ignored) and fill in. Never commit a real value: everything with a real
#  secret here would be a finding (pre-commit gitleaks + config-lint X-group). Values marked
#  "optional" have the documented dev defaults in docker-compose.yml.

# ── provider keys (docs/02 §6) — required for the real pipeline; leave empty + PROVIDER_MODE=MOCK
#    to run the deterministic fixture profile with no paid API
GROQ_API_KEY=
GOOGLE_API_KEY=

# MOCK runs the whole pipeline against canned fixtures. Empty = real providers (requires the keys).
# Only value permitted by the committed config: "MOCK". See specs/config/application-dev.yaml.
PROVIDER_MODE=

# ── bootstrap passwords (compose requires these; never use the documented dev default in shared envs)
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# ── optional overrides ──────────────────────────────────────────────────────────────────────────
GROQ_BASE_URL=https://api.groq.com
ALBARAKA_DAILY_BUDGET_USD=5.00

# Keycloak realm placeholders (dev defaults in docker-compose.yml — override for shared dev envs)
FRONTOFFICE_URL=http://localhost:4200
BACKOFFICE_URL=http://localhost:4300
BANK_PUBLIC_URL=http://localhost:8082
WIDGET_REDIRECT_URI=http://localhost:8082/assistant/callback
